# ============================================================================
# RailAssist 3D — Environment Configuration
# Target Hardware: Intel Core i5-13450HX + NVIDIA RTX 4060 (8GB VRAM)
# Station: Lucknow Charbagh / Lucknow Nr (LKO / LJN)
# ============================================================================

# --- Server & Station Settings ---
HOST=0.0.0.0
PORT=8000
STATION_CODE=LKO
STATION_NAME=Lucknow Charbagh (LKO)
CACHE_REFRESH_SECONDS=300

# --- LLM / Intent Engine (Ollama - NVIDIA RTX 4060 GPU) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_TIMEOUT_SECONDS=2.2
OLLAMA_KEEP_ALIVE=-1

# --- Speech-to-Text (Faster-Whisper - CPU / CTranslate2 int8) ---
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=6

# --- Text-to-Speech (Piper TTS - CPU VITS Architecture) ---
PIPER_EXECUTABLE=piper
PIPER_MODEL_PATH=./models/piper/hi_IN-rohan-medium.onnx
PIPER_CONFIG_PATH=./models/piper/hi_IN-rohan-medium.onnx.json
PIPER_SPEAKER_ID=0

# --- Data Aggregator (RapidAPI Indian Railways Live Status) ---
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=irctc1.p.rapidapi.com
RAPIDAPI_TIMEOUT_SECONDS=2.5

# --- Presentation / Demo Failsafe Mode ---
# When True, automatically falls back to deterministic Hinglish NLU & synthetic
# prosodic WAV audio if Ollama/Piper binaries are not yet started on the machine.
ENABLE_GRACEFUL_FALLBACK=true
